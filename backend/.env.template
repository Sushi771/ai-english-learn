# AI English Learning Assistant - Environment Variables
# Rename this file to .env and fill in the values

# LiteLLM Keys
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
GEMINI_API_KEY=your_gemini_key
ZHIPUAI_API_KEY=your_zhipu_key
DASHSCOPE_API_KEY=your_alibaba_key

# Azure Speech Service
AZURE_SPEECH_KEY=your_azure_key
AZURE_SPEECH_REGION=your_speech_region (e.g., eastus)

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ai_english_learn
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
